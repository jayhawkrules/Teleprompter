{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythie.app/schemas/research_brief.schema.json",
  "title": "Research Brief",
  "description": "A public-internet research brief on a Mythie talent profile. NOT a consumer report under FCRA.",
  "type": "object",
  "required": [
    "briefId",
    "subjectId",
    "subjectKind",
    "subjectFingerprint",
    "requestedBy",
    "requestedByOrg",
    "status",
    "confidence",
    "signals",
    "legalBannerVersion",
    "partnerCraCta",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "briefId": { "type": "string", "description": "Deterministic ID: sha256(subjectFingerprint + requestedByOrg + dayBucket)" },
    "subjectId": { "type": "string", "description": "Subject profile ID in the adopting app" },
    "subjectKind": { "type": "string", "description": "Adopting app's term for the subject (e.g. talent, creator, candidate)" },
    "subjectFingerprint": { "type": "string", "description": "sha256(lowercase name + dob + city) - cache key, never exposed to UI" },
    "requestedBy": { "type": "string", "description": "Mythie user UID" },
    "requestedByOrg": { "type": "string", "description": "Mythie casting workspace ID" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "ready", "failed", "insufficient_signal"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"]
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/Signal" }
    },
    "aiSummaryNarrative": { "type": "string", "maxLength": 2000 },
    "aiSummaryBullets": {
      "type": "array",
      "items": { "type": "string", "maxLength": 280 },
      "maxItems": 7
    },
    "aiRedFlags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 280 },
      "description": "Factual public signals worth discussing with the talent. Never inferred characterisations."
    },
    "legalBannerVersion": {
      "type": "string",
      "pattern": "^v\\d+-\\d{4}-\\d{2}$",
      "description": "Version-pinned banner copy reference, e.g. v1-2026-05"
    },
    "partnerCraCta": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string", "format": "uri" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time", "description": "createdAt + 30 days, TTL purge target" },
    "cacheRefreshedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "Signal": {
      "type": "object",
      "required": [
        "signal_id",
        "source",
        "sourceTier",
        "kind",
        "content",
        "identityMatchConfidence",
        "retrievedAt"
      ],
      "properties": {
        "signal_id": { "type": "string" },
        "source": { "type": "string", "description": "e.g. OpenSanctions, GDELT, NewsAPI, CourtListener, Instagram-public" },
        "sourceTier": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "kind": {
          "type": "string",
          "enum": [
            "sanctions_match",
            "press_mention",
            "civil_docket_reference",
            "social_presence",
            "industry_credit",
            "identity_corroboration"
          ]
        },
        "content": { "type": "string", "maxLength": 2000 },
        "url": { "type": "string", "format": "uri" },
        "identityMatchConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
