{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetManifest",
  "description": "Schema for the asset-manifest.json file used by the asset-aware-creative-pipeline skill",
  "type": "object",
  "required": ["app", "brand"],
  "properties": {
    "app": { "type": "string", "description": "App identifier (lowercase, hyphenated)" },
    "version": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date" },
    "brand": {
      "type": "object",
      "required": ["name", "accentColor", "darkBg"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "darkBg": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "fontFamily": { "type": "string" },
        "logoFile": { "type": "string" },
        "logoLockupFile": { "type": "string" }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "approved"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "description": { "type": "string" },
          "approved": { "type": "boolean" },
          "channels": {
            "type": "array",
            "items": { "type": "string", "enum": ["landing-page", "app-store", "social", "investor", "interactive"] }
          }
        }
      }
    },
    "voice": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "approved"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "description": { "type": "string" },
          "approved": { "type": "boolean" },
          "elevenLabsVoiceId": { "type": ["string", "null"] }
        }
      }
    },
    "copy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "approved"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "channel": { "type": "string" },
          "approved": { "type": "boolean" }
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "approved"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "description": { "type": "string" },
          "approved": { "type": "boolean" },
          "channels": {
            "type": "array",
            "items": { "type": "string", "enum": ["landing-page", "app-store", "social", "investor", "interactive"] }
          }
        }
      }
    }
  }
}
