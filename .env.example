# GEMINI_API_KEY: Required for Gemini AI script generation.
# Set this in your hosting panel's Secrets / Environment Variables section.
# Never use a VITE_ prefix — this key must stay server-side only and never
# be exposed to the browser bundle.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for OAuth callbacks and self-referential links.
APP_URL="YOUR_APP_URL"

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://teleprompter.producinghollywood.com/auth/tiktok/callback"
SESSION_SECRET=""
